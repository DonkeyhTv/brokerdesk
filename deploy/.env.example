# Copy to .env next to compose.yaml, then fill in every value.

# Public host names, without scheme. Both must point to this server for Caddy to obtain certificates.
BROKER_DOMAIN=app.brokerdesk.example
PORTAL_DOMAIN=portal.brokerdesk.example

# Uncomment when another web server on this machine already owns ports 80 and 443 (see compose.behind-proxy.yaml).
# COMPOSE_FILE=compose.yaml:compose.behind-proxy.yaml
# PROXY_PORT=8090

# Generate with: echo "base64:$(openssl rand -base64 32)"
APP_KEY=
# Generate with: openssl rand -hex 24
DB_PASSWORD=

# Exposes demo accounts and erases ALL data every night at 03:00. Keep it for a public demo only.
DEMO_MODE=true
